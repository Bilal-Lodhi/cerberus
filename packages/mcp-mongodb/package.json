{
  "name": "@cerberus/mcp-mongodb",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "description": "Cerberus Model Context Protocol server for MongoDB — persistence layer for telemetry and risk assessments.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "tsx watch src/http-adapter.ts",
    "start": "node dist/http-adapter.js",
    "migrate": "node dist/migrate-cli.js",
    "migrate:dry-run": "node dist/migrate-cli.js --dry-run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "mongodb": "^6.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
