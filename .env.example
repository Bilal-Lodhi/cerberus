# ═══════════════════════════════════════════════════════════════════════════
# Cerberus — environment configuration
# ═══════════════════════════════════════════════════════════════════════════
#
#   cp .env.example .env
#
# This is the ONLY environment file in the repository. Both the API and the
# MCP MongoDB adapter read it. Never commit a real .env — it is gitignored.
#
# Every value below is either a safe local default or an obvious placeholder.
# No real credentials are present. See docs/configuration.md for the full
# reference.
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
# MODE  — read this before anything else
# ───────────────────────────────────────────────────────────────────────────
# CERBERUS_DEV_MODE=true DISABLES AUTHENTICATION on the API and the MCP
# adapter, and allows localhost CORS origins by default.
#
# It is refused outright when NODE_ENV=production.
#
# Set it to false (and fill in the two secrets below) for anything that is
# reachable by anyone other than you on your own machine.
CERBERUS_DEV_MODE=true


# ───────────────────────────────────────────────────────────────────────────
# SERVER
# ───────────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# Maximum accepted request body size, bytes. Default 8388608 (8 MiB).
#
# Enforced before the body is buffered, for authenticated and unauthenticated
# callers alike: an oversized request is refused with HTTP 413 and code
# PAYLOAD_TOO_LARGE, and nothing is truncated. The default matches the ceiling
# the MCP adapter applies to its own bodies, so a request the API admits cannot
# be rejected downstream for size.
#
# Raise it only if a single telemetry batch legitimately exceeds 8 MiB. Must be
# a positive whole number of bytes; anything else is a startup error.
CERBERUS_MAX_BODY_BYTES=8388608


# ───────────────────────────────────────────────────────────────────────────
# AI PROVIDER  — OpenAI (required)
# ───────────────────────────────────────────────────────────────────────────
# Cerberus has exactly one AI backend: the OpenAI Chat Completions API.
# There is no offline/mock analysis mode. Without a key the API refuses to
# start, and there is no fallback provider.
#
# Get a key: https://platform.openai.com/api-keys
#
# NOTE: leave this empty to see the startup validation message; set it to run.
OPENAI_API_KEY=

# Model identifier. Must be a model your account can access.
OPENAI_MODEL_NAME=gpt-5.6

# Upper bound on generated tokens per request.
OPENAI_MAX_OUTPUT_TOKENS=65536

# Sampling temperature, 0-2. Lower is more deterministic.
#
# OPTIONAL and OFF by default. Leave it commented out unless your model accepts
# a custom temperature: the default model (gpt-5.6) rejects any value other than
# its own default and the request fails with HTTP 400. When unset, Cerberus
# omits the parameter entirely and lets the model decide.
# OPENAI_TEMPERATURE=1

# Per-attempt request timeout in milliseconds.
#
# 180s, not 90s: a large structured generation (a multi-vector scenario matrix)
# routinely takes longer than 90s on current models, and a 90s ceiling made the
# provider exhaust all three attempts and give up.
OPENAI_REQUEST_TIMEOUT_MS=180000

# Optional: override the API base URL (proxies, self-hosted gateways).
# OPENAI_BASE_URL=https://api.openai.com/v1


# ───────────────────────────────────────────────────────────────────────────
# MONGODB
# ───────────────────────────────────────────────────────────────────────────
# docker-compose.yml provides a local MongoDB. The default below matches it.
# For Atlas use: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb://localhost:27017

# Database name. Collections created automatically:
#   threat_scenarios, monitored_sessions, micro_events, risk_assessments
MONGODB_DATABASE=cerberus


# ───────────────────────────────────────────────────────────────────────────
# MCP PERSISTENCE ADAPTER
# ───────────────────────────────────────────────────────────────────────────
# Internal sidecar the API calls to reach MongoDB. Not browser-facing.
MCP_SERVER_ENDPOINT=http://localhost:3001
MCP_PORT=3001

# Bind address. Keep this on loopback unless you deliberately expose the
# adapter; it has no TLS and its only protection is the shared token below.
MCP_BIND_HOST=127.0.0.1

# Per-call timeout for MCP operations, milliseconds.
MCP_TIMEOUT_MS=10000

# Shared secret the API presents to the MCP adapter as
# `Authorization: Bearer <token>`. Required whenever CERBERUS_DEV_MODE=false.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CERBERUS_MCP_TOKEN=

# Optional rotation overlap for the MCP token. Set the new token above, put the
# old one here, restart both services, move the API across, then unset this and
# restart again. See docs/operations/key-rotation.md.
CERBERUS_MCP_TOKEN_PREVIOUS=

# Comma-separated allow-list for browser origins hitting the MCP adapter.
# Leave EMPTY: this interface is server-to-server and should stay closed.
CERBERUS_MCP_CORS_ORIGINS=


# ───────────────────────────────────────────────────────────────────────────
# AUTHENTICATION
# ───────────────────────────────────────────────────────────────────────────
# The operator API key. Every endpoint except GET /health requires it,
# presented as `Authorization: Bearer <key>` or `X-API-Key: <key>`.
# Required whenever CERBERUS_DEV_MODE=false. Compared in constant time.
#
# There is no default production credential: if this is empty and dev mode is
# off, the API exits at startup.
CERBERUS_API_KEY=

# Optional rotation overlap. Set the new key above, put the old one here,
# restart, move every client across, then unset this and restart again.
#
# Both keys are compared in constant time, and neither is ever logged. Setting
# this WITHOUT CERBERUS_API_KEY is a startup error: an overlap is not a
# replacement. See docs/operations/key-rotation.md.
CERBERUS_API_KEY_PREVIOUS=


# ───────────────────────────────────────────────────────────────────────────
# RATE LIMITING
# ───────────────────────────────────────────────────────────────────────────
# In-process token-bucket limiting, applied per route category AFTER
# authentication. A backstop against a runaway client or a retry loop, NOT DDoS
# defence: it runs in one process with no shared state, so N replicas enforce up
# to N times the limit.
#
# Unauthenticated requests are deliberately not limited here. A limiter placed
# before auth would let an anonymous caller exhaust a bucket and deny service to
# the operator. Bound those at your reverse proxy instead; see
# docs/operations/reverse-proxy.md.
#
# X-Forwarded-For is NOT trusted: behind a proxy it is caller-controlled unless
# the proxy overwrites it, and trusting it would let a caller mint a fresh bucket
# per request.
CERBERUS_RATE_LIMIT_ENABLED=true

# Requests per minute on the AI-backed endpoints (POST /api/v1/scenarios and
# POST /api/v1/auditor/query). Every request there spends money, so this is a cost
# control as much as an abuse control. The other categories are documented
# backstops with fixed ceilings rather than knobs:
#
#   ingest    600/min   POST /api/v1/guardian/ingest
#   mutation   60/min   state changes
#   read      300/min   reads
#   health       -      exempt (a limited probe looks like a dead service)
CERBERUS_AI_REQUESTS_PER_MINUTE=10


# ───────────────────────────────────────────────────────────────────────────
# CORS
# ───────────────────────────────────────────────────────────────────────────
# Comma-separated allow-list of browser origins permitted to call the API.
# With no allow-list and no dev mode, NO cross-origin access is granted.
# When CERBERUS_DEV_MODE=true and this is empty, localhost dev origins are
# allowed automatically.
#
# Example: CERBERUS_CORS_ORIGINS=http://localhost:5173,https://console.example.com
CERBERUS_CORS_ORIGINS=


# ───────────────────────────────────────────────────────────────────────────
# DETECTION THRESHOLDS
# ───────────────────────────────────────────────────────────────────────────
# Session lifetime, seconds. ENFORCED.
#
# A session is live while its most recent activity is younger than this. Once
# the window closes the session is no longer monitored: it is excluded from
# GET /api/v1/guardian/sessions, it is not restored as live by a restart, and it
# refuses new telemetry with HTTP 409 SESSION_EXPIRED until it is explicitly
# reopened with POST /api/v1/guardian/sessions/<id>/reactivate.
#
# Expiry NEVER deletes or hides evidence. Review data is retained and is still
# served by GET /api/v1/sessions and GET /api/v1/sessions/<id>. Deleting a
# session remains an explicit action (DELETE /api/v1/guardian/sessions/<id>).
#
# Must be a positive whole number of seconds. Anything else (0, -1, 1.5, 1e3,
# "abc") is a startup error rather than a silent fallback, because this value
# decides how long a monitored operator can be observed.
SESSION_TTL_SECONDS=7200

# Paste events in a session before risk analysis is forced.
MAX_PASTE_EVENTS=5

# Inter-key delay (ms) below which typing is treated as non-human.
MIN_HUMAN_KEYSTROKE_MS=80

# Similarity (0-1) at which content is treated as a data-leakage match.
DATA_LEAKAGE_SIMILARITY_THRESHOLD=0.75


# ───────────────────────────────────────────────────────────────────────────
# NOTIFICATIONS  — optional, all no-op when unset
# ───────────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_TO=
