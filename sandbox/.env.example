# ═══════════════════════════════════════════════════════════════
# 🔒 Cerberus FinSec — Local Development Environment
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# This file is auto-loaded by start-services.js via dotenv.
# NEVER commit .env files with real credentials.
# ═══════════════════════════════════════════════════════════════

# ─── MongoDB Atlas Connection ─────────────────────────────────
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Free tier available at: https://www.mongodb.com/atlas/database
MONGODB_URI=YOUR_MONGODB_ATLAS_URI_HERE
MONGODB_DATABASE=gorilla_agents

# ─── OpenAI API (GPT-5.6) ─────────────────────────────────────
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
#
# ── Model Settings ─────────────────────────────────────────────
OPENAI_MODEL_NAME=gpt-5.6
OPENAI_MAX_OUTPUT_TOKENS=65536
OPENAI_TEMPERATURE=1
# ── Optional: API base URL (for proxies / dedicated instances) ─
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Service Ports (optional, defaults below) ─────────────────
PORT=8080
MCP_PORT=3001
