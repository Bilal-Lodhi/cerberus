# ═══════════════════════════════════════════════════════════════
# 🦍 Cerberus AI — Hono API Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# NEVER commit .env files with real credentials.
# ═══════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────
PORT=8080

# ─── Google Cloud Vertex AI / Gemini API ───────────────────────
# ⚠️ JUDGES: You can use EITHER option A or option B below.
# Option A (Recommended): Free Gemini API key from https://aistudio.google.com/apikey
#   → Works immediately, no GCP project needed, gemini-3-flash-preview available.
# Option B: Vertex AI via GCP project + Application Default Credentials (ADC)
#   → Requires `gcloud auth application-default login` and a GCP project.
#   → NOTE: gemini-3-flash-preview on Vertex AI requires GCP_LOCATION=global
#     which can return 404 errors during preview phases for some billing accounts.
#   → If Vertex AI fails, set GEMINI_API_KEY (Option A) as a reliable fallback.
#
# OPTION A: Free Gemini API key (takes priority if set).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# OPTION B: Vertex AI via GCP project + ADC (fallback if no API key).
GCP_PROJECT_ID=YOUR_PROJECT_ID
GCP_LOCATION=global
#
# ── Model Settings ─────────────────────────────────────────────
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MAX_OUTPUT_TOKENS=65536
GEMINI_TEMPERATURE=1
# Per-attempt timeout (ms) for a single Vertex AI call. Increase for
# large test suite generations. 90000 = 90 seconds (default).
GEMINI_REQUEST_TIMEOUT_MS=90000

# ─── MCP Server Connectivity (MongoDB Track) ───────────────────
# URL of the gorilla MCP server (local dev only; Cloud Run uses MONGODB_URI directly)
MCP_SERVER_ENDPOINT=http://localhost:3001
MCP_API_KEY=
MCP_TIMEOUT_MS=10000

# ─── Security / Anti-Cheat Thresholds ──────────────────────────
SESSION_TTL_SECONDS=7200
MAX_PASTE_EVENTS=5
MIN_HUMAN_KEYSTROKE_MS=80
PLAGIARISM_THRESHOLD=0.75

# High-risk incident notifications (optional)
SLACK_WEBHOOK_URL=
SENDGRID_API_KEY=
EMAIL_FROM=alerts@cerberus.ai
EMAIL_TO=security@company.com
