{
  "name": "cerberus",
  "version": "0.5.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Cerberus — real-time insider-threat and data-exfiltration telemetry guardian.",
  "type": "module",
  "workspaces": [
    "apps/api",
    "packages/mcp-mongodb"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build --workspace @cerberus/api && npm run build --workspace @cerberus/mcp-mongodb",
    "build:api": "npm run build --workspace @cerberus/api",
    "build:mcp": "npm run build --workspace @cerberus/mcp-mongodb",
    "typecheck": "npm run typecheck --workspace @cerberus/api && npm run typecheck --workspace @cerberus/mcp-mongodb",
    "typecheck:tests": "npm run typecheck:tests --workspace @cerberus/api",
    "test": "npm run test --workspace @cerberus/api && npm run test --workspace @cerberus/mcp-mongodb",
    "test:migrations": "npm run test:migrations --workspace @cerberus/api",
    "migrate": "npm run migrate --workspace @cerberus/mcp-mongodb",
    "migrate:dry-run": "npm run migrate:dry-run --workspace @cerberus/mcp-mongodb",
    "dev": "node scripts/dev-services.js",
    "start": "node scripts/start-services.js",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-all.ps1",
    "backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-cerberus.ps1",
    "restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restore-cerberus.ps1",
    "bench": "npm run build:api && node scripts/bench/run-bench.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "console:format": "cd apps/console && dart format --output=none --set-exit-if-changed .",
    "console:analyze": "cd apps/console && flutter analyze",
    "console:test": "cd apps/console && flutter test",
    "verify:console-smoke": "node scripts/release/console-smoke.mjs",
    "verify:version": "node scripts/release/version-census.mjs",
    "verify:config": "node scripts/release/config-census.mjs",
    "verify:secrets": "node scripts/release/secret-guards.mjs",
    "verify:packages": "node scripts/release/private-packages.mjs",
    "verify:attribution": "node scripts/release/attribution-guard.mjs",
    "verify:backup": "node scripts/release/backup-restore-drill.mjs",
    "verify:image": "node scripts/release/verify-image.mjs",
    "verify:release": "node scripts/release/verify-release.mjs"
  }
}
