    "test": "node --import tsx --test test/*.test.ts test/integration/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "dotenv": "^16.6.1",
    "hono": "^4.6.14",
    "openai": "^6.46.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "mongodb": "^6.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
