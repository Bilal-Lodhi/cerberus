{
  "name": "@cerberus/api",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Cerberus HTTP API — telemetry ingestion, risk analysis and session review.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
